{
  "id": "novelupdates",
  "version": 1,
  "name": "Novel Updates",
  "description": "Directory, tracker, and reading index for Asian translated web novels",
  "minimum_engine_version": 1,
  "match": {
    "hosts": [
      "novelupdates.com",
      "www.novelupdates.com"
    ],
    "url_patterns": [
      "https://www.novelupdates.com/series/*",
      "https://novelupdates.com/series/*"
    ],
    "novel_url_pattern": "https://www.novelupdates.com/series/*"
  },
  "requests": {
    "default": {
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36 NovelLibrary/0.1"
      }
    }
  },
  "novel": {
    "title": {
      "selector": ".seriestitlenine, h1.seriestitlenine, h1",
      "type": "text",
      "transform": ["trim"]
    },
    "author": {
      "selector": "#authtag, #showauthors a, #showauthors",
      "type": "text",
      "transform": ["trim"]
    },
    "description": {
      "selector": "#editdescription, .seriesdesc, #editdescription p",
      "type": "html",
      "transform": ["trim"]
    },
    "cover": {
      "selector": ".seriesimg img, .seriesimg",
      "type": "attribute",
      "attribute": "src",
      "transform": ["absolute_url"]
    },
    "status": {
      "selector": "#editstatus, .status",
      "type": "text",
      "transform": ["trim"]
    },
    "tags": {
      "selector": "#showtags a, #showgenre a, a.genre, a.genretag",
      "attribute": "text",
      "transform": "trim"
    },
    "content_warnings": {
      "selector": "#showwarning a, .warning, .contentwarning",
      "attribute": "text",
      "transform": "trim"
    }
  },
  "chapters": {
    "container": "table#myTable tbody tr, #myTable tr, ul.sp-toc li, a.chp_a",
    "title": {
      "selector": "a",
      "type": "text",
      "transform": ["trim"]
    },
    "url": {
      "selector": "a",
      "type": "attribute",
      "attribute": "href",
      "transform": ["absolute_url"]
    }
  },
  "chapter": {
    "content": {
      "selector": "div.entry-content, article, div#content, .chapter-content",
      "type": "html"
    },
    "sanitize": {
      "remove_tags": ["script", "style", "iframe", "button"],
      "allow_tags": ["p", "br", "b", "i", "em", "strong", "h1", "h2", "h3", "blockquote"]
    }
  }
}
