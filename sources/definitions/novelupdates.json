{
  "id": "novelupdates",
  "version": 4,
  "name": "Novel Updates",
  "description": "Novel Updates Asian web novel directory and releases",
  "minimum_engine_version": 1,
  "match": {
    "hosts": [
      "novelupdates.com",
      "www.novelupdates.com"
    ],
    "url_patterns": [
      "https://www.novelupdates.com/series/*",
      "https://novelupdates.com/series/*",
      "https://www.novelupdates.com/extnu/*",
      "https://novelupdates.com/extnu/*"
    ],
    "novel_url_pattern": "https://(?:www\\.)?novelupdates\\.com/series/[^/]+/$"
  },
  "requests": {
    "default": {
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36 NovelLibrary/0.1"
      }
    }
  },
  "rendering": {
    "mode": "auto",
    "ready_selector": "div.entry-content, article, div#content, div.reading-content",
    "min_text_characters": 300,
    "max_wait_ms": 12000,
    "scroll_until_stable": false
  },
  "novel": {
    "title": {
      "selector": ".seriestitlenu, h1.seriestitlenu, .seriestitle, h1",
      "type": "text",
      "transform": ["trim"]
    },
    "author": {
      "selector": "#showauthors a, #showauthors, .author a",
      "type": "text",
      "transform": ["trim"]
    },
    "description": {
      "selector": "#editdescription, .seriesdesc",
      "type": "html",
      "transform": ["trim"]
    },
    "cover": {
      "selector": ".seriesimg img, .seriesimage img, img.seriesimg",
      "type": "attribute",
      "attribute": "src",
      "transform": ["absolute_url"]
    },
    "status": {
      "selector": "#editstatus, .status",
      "type": "text",
      "transform": ["trim"]
    },
    "tags": {
      "selector": "#seriesgenre a, #showtags a, .genre a",
      "attribute": "text",
      "transform": "trim"
    },
    "contentWarnings": {
      "selector": ".warning a, .warning",
      "attribute": "text",
      "transform": "trim"
    }
  },
  "chapters": {
    "container": "a.chp-release-title, a[href*='/extnu/']",
    "title": {
      "selector": "a.chp-release-title, a[href*='/extnu/']",
      "type": "text",
      "transform": ["trim"]
    },
    "url": {
      "selector": "a.chp-release-title, a[href*='/extnu/']",
      "type": "attribute",
      "attribute": "href",
      "transform": ["absolute_url"]
    },
    "order": "desc"
  },
  "chapter": {
    "content": {
      "selector": "div.entry-content, article, div#content, .chapter-content, div.reading-content, div.text-left, div.post-content, div.post-body, .epcontent, #chapter-content",
      "type": "html"
    },
    "content_selectors": [
      {
        "selector": "div.entry-content",
        "type": "html"
      },
      {
        "selector": "article",
        "type": "html"
      },
      {
        "selector": "div#content",
        "type": "html"
      },
      {
        "selector": ".chapter-content",
        "type": "html"
      },
      {
        "selector": "div.reading-content",
        "type": "html"
      },
      {
        "selector": "div.text-left",
        "type": "html"
      },
      {
        "selector": "div.post-content, div.post-body",
        "type": "html"
      }
    ],
    "validation": {
      "min_text_characters": 300,
      "min_paragraphs": 2,
      "max_link_density": 0.35,
      "reject_title_patterns": [
        "just a moment",
        "checking your browser",
        "access denied",
        "verify you are human"
      ]
    },
    "sanitize": {
      "remove_tags": ["script", "style", "iframe", "button"],
      "allow_tags": ["p", "br", "b", "i", "em", "strong", "h1", "h2", "h3", "blockquote"]
    }
  }
}
