{
  "id": "novgo",
  "version": 3,
  "name": "NovGo",
  "description": "NovGo online light novel library",
  "minimum_engine_version": 1,
  "match": {
    "hosts": [
      "novgo.net",
      "www.novgo.net"
    ],
    "url_patterns": [
      "https://novgo.net/*",
      "https://www.novgo.net/*"
    ],
    "novel_url_pattern": "https://(?:www\\.)?novgo\\.net/[^/]+\\.html$"
  },
  "requests": {
    "default": {
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36 NovelLibrary/0.1"
      }
    }
  },
  "rendering": {
    "mode": "auto",
    "ready_selector": "#chapter-content",
    "min_text_characters": 300,
    "max_wait_ms": 12000,
    "scroll_until_stable": false
  },
  "novel": {
    "title": {
      "selector": "h1.tit, .tit, h1",
      "type": "text",
      "transform": ["trim", "decode_html"]
    },
    "author": {
      "selector": ".author a, .author, span:contains(Author) a",
      "type": "text",
      "transform": ["trim"]
    },
    "description": {
      "selector": ".desc, .intro, .synopsis",
      "type": "html",
      "transform": ["trim"]
    },
    "cover": {
      "selector": ".pic img, .img img, .cover img, img[src*='/cover/']",
      "type": "attribute",
      "attribute": "src",
      "transform": ["absolute_url"]
    },
    "status": {
      "selector": ".status, .state",
      "type": "text",
      "transform": ["trim"]
    },
    "tags": {
      "selector": ".genre a, .tags a, .tag a",
      "attribute": "text",
      "transform": "trim"
    },
    "contentWarnings": {
      "selector": ".warning a, .warning",
      "attribute": "text",
      "transform": "trim"
    }
  },
  "chapters": {
    "container": "#idData li",
    "pagination": {
      "selector": "#indexselect option",
      "type": "attribute",
      "attribute": "data-url",
      "transform": ["absolute_url"]
    },
    "title": {
      "selector": "a.con, a",
      "type": "text",
      "transform": ["trim", "decode_html"]
    },
    "url": {
      "selector": "a.con, a",
      "type": "attribute",
      "attribute": "href",
      "transform": ["absolute_url"]
    }
  },
  "chapter": {
    "content": {
      "selector": "#chapter-content",
      "type": "html"
    },
    "content_selectors": [
      {
        "selector": "#chapter-content",
        "type": "html"
      },
      {
        "selector": ".chapter-content",
        "type": "html"
      },
      {
        "selector": "article",
        "type": "html"
      }
    ],
    "validation": {
      "min_text_characters": 300,
      "min_paragraphs": 2,
      "max_link_density": 0.35,
      "reject_title_patterns": [
        "just a moment",
        "checking your browser",
        "access denied",
        "verify you are human"
      ]
    },
    "sanitize": {
      "remove_tags": ["script", "style", "iframe", "button", "div.ads", "div.ad", "ins"],
      "allow_tags": ["p", "br", "b", "i", "em", "strong", "h1", "h2", "h3", "blockquote"]
    }
  }
}
