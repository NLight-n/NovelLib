{
  "id": "scribblehub",
  "version": 5,
  "name": "Scribble Hub",
  "description": "Scribble Hub original web fiction community",
  "minimum_engine_version": 1,
  "match": {
    "hosts": [
      "scribblehub.com",
      "www.scribblehub.com"
    ],
    "url_patterns": [
      "https://www.scribblehub.com/series/*",
      "https://scribblehub.com/series/*",
      "https://www.scribblehub.com/read/*",
      "https://scribblehub.com/read/*"
    ],
    "novel_url_pattern": "https://www.scribblehub.com/series/*"
  },
  "requests": {
    "default": {
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36 NovelLibrary/0.1"
      }
    }
  },
  "rendering": {
    "mode": "auto",
    "ready_selector": "div.chp_raw",
    "min_text_characters": 300,
    "max_wait_ms": 12000,
    "scroll_until_stable": false
  },
  "novel": {
    "title": {
      "selector": ".fic_title, h1.fic_title, h1",
      "type": "text",
      "transform": ["trim"]
    },
    "author": {
      "selector": "span.auth_name_fic a, span.auth_name_fic, .auth_name_fic",
      "type": "text",
      "transform": ["trim"]
    },
    "description": {
      "selector": "div.wi_fic_desc, .wi_fic_desc",
      "type": "html",
      "transform": ["trim"]
    },
    "cover": {
      "selector": "div.fic_image img, .fic_image img, img.fic_image",
      "type": "attribute",
      "attribute": "src",
      "transform": ["absolute_url"]
    },
    "status": {
      "selector": "span.widget_fic_similar",
      "type": "text",
      "transform": ["trim"]
    },
    "tags": {
      "selector": "span.wi_fic_genre a, a.fic_genre, span.tags a",
      "attribute": "text",
      "transform": "trim"
    },
    "contentWarnings": {
      "selector": ".raw_warning, .raw_warning a, .content_warning a, .warning_list li",
      "attribute": "text",
      "transform": "trim"
    }
  },
  "chapters": {
    "container": "ul.toc_w li.toc_li, .toc_li, ul.toc_w li, a.toc_a, #novellib-injected-toc a.toc_a, #novellib-injected-toc li",
    "title": {
      "selector": "a.toc_a, a",
      "type": "text",
      "transform": ["trim"]
    },
    "url": {
      "selector": "a.toc_a, a",
      "type": "attribute",
      "attribute": "href",
      "transform": ["absolute_url"]
    },
    "published_at": {
      "selector": "span.fic_date_pub",
      "type": "text",
      "transform": ["trim"]
    }
  },
  "chapter": {
    "content": {
      "selector": "div.chp_raw, .chp_raw, #chp_raw",
      "type": "html"
    },
    "content_selectors": [
      {
        "selector": "div.chp_raw",
        "type": "html"
      },
      {
        "selector": "#chp_raw",
        "type": "html"
      },
      {
        "selector": ".chp_raw",
        "type": "html"
      },
      {
        "selector": "article",
        "type": "html"
      }
    ],
    "validation": {
      "min_text_characters": 300,
      "min_paragraphs": 2,
      "max_link_density": 0.35,
      "reject_title_patterns": [
        "just a moment",
        "checking your browser",
        "access denied",
        "verify you are human"
      ]
    },
    "sanitize": {
      "remove_tags": ["script", "style", "iframe", "button"],
      "allow_tags": ["p", "br", "b", "i", "em", "strong", "h1", "h2", "h3", "blockquote"]
    }
  }
}
