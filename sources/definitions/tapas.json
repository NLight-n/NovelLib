{
  "id": "tapas",
  "version": 2,
  "name": "Tapas",
  "description": "Tapas digital comics and web novels platform",
  "minimum_engine_version": 1,
  "match": {
    "hosts": [
      "tapas.io",
      "www.tapas.io"
    ],
    "url_patterns": [
      "https://tapas.io/series/*",
      "https://www.tapas.io/series/*",
      "https://tapas.io/episode/*",
      "https://www.tapas.io/episode/*"
    ],
    "novel_url_pattern": "https://(?:www\\.)?tapas\\.io/series/[^/]+(?:/info)?$"
  },
  "requests": {
    "default": {
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36 NovelLibrary/0.1"
      }
    }
  },
  "rendering": {
    "mode": "auto",
    "ready_selector": "article.viewer__body, div.viewer__body, .content__body",
    "min_text_characters": 300,
    "max_wait_ms": 12000,
    "scroll_until_stable": false
  },
  "novel": {
    "title": {
      "selector": ".series-header .title, h1.title, h1",
      "type": "text",
      "transform": ["trim"]
    },
    "author": {
      "selector": ".creator-info .name, a.name, .author, span.name",
      "type": "text",
      "transform": ["trim"]
    },
    "description": {
      "selector": ".description, .description__body, div.info-desc",
      "type": "html",
      "transform": ["trim"]
    },
    "cover": {
      "selector": ".thumb img, .thumb-wrap img, img.thumb, meta[property='og:image']",
      "type": "attribute",
      "attribute": "src",
      "transform": ["absolute_url"]
    },
    "status": {
      "selector": ".additional-info .status, span.status",
      "type": "text",
      "transform": ["trim"]
    },
    "tags": {
      "selector": ".genre a, .tag-list a, .genre-btn, a.genre",
      "attribute": "text",
      "transform": "trim"
    },
    "contentWarnings": {
      "selector": ".warning, .badge--warning",
      "attribute": "text",
      "transform": "trim"
    }
  },
  "chapters": {
    "container": "ul.episode-list li, .episode-list li, li.episode",
    "title": {
      "selector": "a.item__title, .episode-title, a",
      "type": "text",
      "transform": ["trim"]
    },
    "url": {
      "selector": "a",
      "type": "attribute",
      "attribute": "href",
      "transform": ["absolute_url"]
    }
  },
  "chapter": {
    "content": {
      "selector": "article.viewer__body, div.viewer__body, .content__body, article",
      "type": "html"
    },
    "content_selectors": [
      {
        "selector": "article.viewer__body",
        "type": "html"
      },
      {
        "selector": "div.viewer__body",
        "type": "html"
      },
      {
        "selector": ".content__body",
        "type": "html"
      },
      {
        "selector": "article",
        "type": "html"
      }
    ],
    "validation": {
      "min_text_characters": 300,
      "min_paragraphs": 2,
      "max_link_density": 0.35,
      "reject_title_patterns": [
        "just a moment",
        "checking your browser",
        "access denied",
        "verify you are human",
        "sign in to read",
        "unlock episode"
      ]
    },
    "sanitize": {
      "remove_tags": ["script", "style", "iframe", "button"],
      "allow_tags": ["p", "br", "b", "i", "em", "strong", "h1", "h2", "h3", "blockquote"]
    }
  }
}
