{
  "id": "tapas",
  "version": 1,
  "name": "Tapas",
  "description": "Web novels, serialized community books, and light fiction",
  "minimum_engine_version": 1,
  "match": {
    "hosts": [
      "tapas.io",
      "www.tapas.io"
    ],
    "url_patterns": [
      "https://tapas.io/series/*",
      "https://www.tapas.io/series/*",
      "https://tapas.io/episode/*",
      "https://www.tapas.io/episode/*"
    ],
    "novel_url_pattern": "https://tapas.io/series/*"
  },
  "requests": {
    "default": {
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36 NovelLibrary/0.1"
      }
    }
  },
  "novel": {
    "title": {
      "selector": "h1.title, .title, a.title, .series-header__title, h1",
      "type": "text",
      "transform": ["trim"]
    },
    "author": {
      "selector": "a.creator, .creator__name, a[href*='/creator/'], .creator",
      "type": "text",
      "transform": ["trim"]
    },
    "description": {
      "selector": ".description, .content__body, p.desc, meta[property='og:description']",
      "type": "html",
      "transform": ["trim"]
    },
    "cover": {
      "selector": "img.thumb, .thumb img, meta[property='og:image'], img",
      "type": "attribute",
      "attribute": "src",
      "transform": ["absolute_url"]
    },
    "status": {
      "selector": ".status, .badge",
      "type": "text",
      "transform": ["trim"]
    },
    "tags": {
      "selector": "a.tag, .tag, a[href*='/genres/'], .genre, .sub-genre",
      "attribute": "text",
      "transform": "trim"
    },
    "content_warnings": {
      "selector": ".warning, .badge--warning",
      "attribute": "text",
      "transform": "trim"
    }
  },
  "chapters": {
    "container": "ul.episode-list li, .episode-list li, li.episode",
    "title": {
      "selector": "a.item__title, .episode-title, a",
      "type": "text",
      "transform": ["trim"]
    },
    "url": {
      "selector": "a",
      "type": "attribute",
      "attribute": "href",
      "transform": ["absolute_url"]
    }
  },
  "chapter": {
    "content": {
      "selector": "article.viewer__body, div.viewer__body, .content__body, article",
      "type": "html"
    },
    "sanitize": {
      "remove_tags": ["script", "style", "iframe", "button"],
      "allow_tags": ["p", "br", "b", "i", "em", "strong", "h1", "h2", "h3", "blockquote"]
    }
  }
}
