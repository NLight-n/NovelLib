{
  "id": "royalroad",
  "version": 5,
  "name": "Royal Road",
  "description": "Royal Road online web fiction platform",
  "minimum_engine_version": 1,
  "match": {
    "hosts": [
      "royalroad.com",
      "www.royalroad.com"
    ],
    "url_patterns": [
      "https://www.royalroad.com/fiction/*",
      "https://royalroad.com/fiction/*"
    ],
    "novel_url_pattern": "https://www.royalroad.com/fiction/*"
  },
  "requests": {
    "default": {
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36 NovelLibrary/0.1"
      }
    }
  },
  "rendering": {
    "mode": "auto",
    "ready_selector": ".chapter-content",
    "min_text_characters": 300,
    "max_wait_ms": 12000,
    "scroll_until_stable": false
  },
  "novel": {
    "title": {
      "selector": "h1",
      "type": "text",
      "transform": ["trim"]
    },
    "author": {
      "selector": "h4 a",
      "type": "text",
      "transform": ["trim"]
    },
    "description": {
      "selector": ".description .hidden-content, .description, div[property='description'], .fiction-info .description, meta[property='og:description']",
      "type": "html",
      "transform": ["trim"]
    },
    "cover": {
      "selector": "img[data-type='cover'], .cover-art-container img, .cover-col img, .thumbnail[data-type='cover'], img.thumbnail",
      "type": "attribute",
      "attribute": "src",
      "transform": ["absolute_url"]
    },
    "status": {
      "selector": ".fiction-info .label",
      "type": "text",
      "transform": ["trim"]
    },
    "tags": {
      "selector": "span.tags a.fiction-tag, span.tags a",
      "attribute": "text",
      "transform": "trim"
    },
    "contentWarnings": {
      "selector": ".font-red-sunglo ul.list-inline li, ul.list-inline li",
      "attribute": "text",
      "transform": "trim"
    }
  },
  "chapters": {
    "container": "#chapters tbody tr",
    "title": {
      "selector": "td:first-child a",
      "type": "text",
      "transform": ["trim"]
    },
    "url": {
      "selector": "td:first-child a",
      "type": "attribute",
      "attribute": "href",
      "transform": ["absolute_url"]
    },
    "published_at": {
      "selector": "time",
      "type": "attribute",
      "attribute": "unixtimestamp"
    }
  },
  "chapter": {
    "content": {
      "selector": ".chapter-content",
      "type": "html"
    },
    "content_selectors": [
      {
        "selector": ".chapter-content",
        "type": "html"
      },
      {
        "selector": ".chapter-inner",
        "type": "html"
      },
      {
        "selector": "article",
        "type": "html"
      }
    ],
    "validation": {
      "min_text_characters": 300,
      "min_paragraphs": 2,
      "max_link_density": 0.35,
      "reject_title_patterns": [
        "just a moment",
        "checking your browser",
        "access denied",
        "verify you are human"
      ]
    },
    "sanitize": {
      "remove_tags": ["script", "style", "iframe", "button", "div.author-note-portlet"],
      "allow_tags": ["p", "br", "b", "i", "em", "strong", "h1", "h2", "h3", "blockquote"]
    }
  }
}
