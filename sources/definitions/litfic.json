{
  "id": "litfic",
  "version": 4,
  "name": "LitFic",
  "description": "LitFic independent web fiction and novel platform",
  "minimum_engine_version": 1,
  "match": {
    "hosts": [
      "litfic.com",
      "www.litfic.com"
    ],
    "url_patterns": [
      "https://litfic.com/*",
      "https://www.litfic.com/*"
    ],
    "novel_url_pattern": "https://(?:www\\.)?litfic\\.com/series/[^/]+$"
  },
  "requests": {
    "default": {
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36 NovelLibrary/0.1"
      }
    }
  },
  "rendering": {
    "mode": "auto",
    "ready_selector": "div.reader-content, article, div[class*='reader']",
    "min_text_characters": 300,
    "max_wait_ms": 12000,
    "scroll_until_stable": false
  },
  "novel": {
    "title": {
      "selector": "main h1, h1.font-display, h1, meta[property='og:title'], title",
      "type": "text",
      "transform": ["trim"]
    },
    "author": {
      "selector": "a[href*='/author/'], a[href*='/user/'], .author-name, span.font-medium",
      "type": "text",
      "transform": ["trim"]
    },
    "description": {
      "selector": "div[class*='description'], div[class*='synopsis'], .prose",
      "type": "html",
      "transform": ["trim"]
    },
    "cover": {
      "selector": "img[src*='covers'], img[alt*='cover'], img[class*='rounded'], meta[property='og:image']",
      "type": "attribute",
      "attribute": "src",
      "transform": ["absolute_url"]
    },
    "status": {
      "selector": "span[class*='status'], span[class*='badge']",
      "type": "text",
      "transform": ["trim"]
    },
    "tags": {
      "selector": "a[href*='/tag/'], a[href*='/genre/'], span[class*='badge']",
      "attribute": "text",
      "transform": "trim"
    },
    "contentWarnings": {
      "selector": "span[class*='warning'], .text-red-500",
      "attribute": "text",
      "transform": "trim"
    }
  },
  "chapters": {
    "container": "a[href*='/series/'], div a[href*='/series/']",
    "title": {
      "selector": "span, p, a",
      "type": "text",
      "transform": ["trim"]
    },
    "url": {
      "selector": "a, this",
      "type": "attribute",
      "attribute": "href",
      "transform": ["absolute_url"]
    }
  },
  "chapter": {
    "content": {
      "selector": "div.reader-content, article, div[class*='reader']",
      "type": "html"
    },
    "content_selectors": [
      {
        "selector": "div.reader-content",
        "type": "html"
      },
      {
        "selector": "article",
        "type": "html"
      },
      {
        "selector": "div[class*='reader']",
        "type": "html"
      }
    ],
    "validation": {
      "min_text_characters": 300,
      "min_paragraphs": 2,
      "max_link_density": 0.35,
      "reject_title_patterns": [
        "just a moment",
        "checking your browser",
        "access denied",
        "verify you are human"
      ]
    },
    "sanitize": {
      "remove_tags": ["script", "style", "iframe", "button"],
      "allow_tags": ["p", "br", "b", "i", "em", "strong", "h1", "h2", "h3", "blockquote"]
    }
  }
}
