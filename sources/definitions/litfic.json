{
  "id": "litfic",
  "version": 1,
  "name": "LitFic",
  "description": "Serialized modern fiction, web novels, and original community stories",
  "minimum_engine_version": 1,
  "match": {
    "hosts": [
      "litfic.com",
      "www.litfic.com"
    ],
    "url_patterns": [
      "https://litfic.com/series/*",
      "https://www.litfic.com/series/*",
      "https://litfic.com/browse*",
      "https://www.litfic.com/browse*"
    ],
    "novel_url_pattern": "https://litfic.com/series/*"
  },
  "requests": {
    "default": {
      "method": "GET",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Mobile Safari/537.36 NovelLibrary/0.1"
      }
    }
  },
  "novel": {
    "title": {
      "selector": "h1, .font-display",
      "type": "text",
      "transform": ["trim"]
    },
    "author": {
      "selector": "a[href*='/profile/'], a[href*='/author/'], .text-flame",
      "type": "text",
      "transform": ["trim"]
    },
    "description": {
      "selector": ".prose, .reader-content, p",
      "type": "html",
      "transform": ["trim"]
    },
    "cover": {
      "selector": "img[src*='covers'], img[src*='firebasestorage'], .relative img, img",
      "type": "attribute",
      "attribute": "src",
      "transform": ["absolute_url"]
    },
    "status": {
      "selector": ".badge, span[class*='status']",
      "type": "text",
      "transform": ["trim"]
    },
    "tags": {
      "selector": "a[href*='/browse?'], a[href*='/genres/'], .badge, span.tag",
      "attribute": "text",
      "transform": "trim"
    },
    "content_warnings": {
      "selector": "span[class*='warning'], .text-red-500",
      "attribute": "text",
      "transform": "trim"
    }
  },
  "chapters": {
    "container": "a[href*='/series/'], div a[href*='/series/']",
    "title": {
      "selector": "span, p, a",
      "type": "text",
      "transform": ["trim"]
    },
    "url": {
      "selector": "a, this",
      "type": "attribute",
      "attribute": "href",
      "transform": ["absolute_url"]
    }
  },
  "chapter": {
    "content": {
      "selector": "div.reader-content, article, div[class*='reader']",
      "type": "html"
    },
    "sanitize": {
      "remove_tags": ["script", "style", "iframe", "button"],
      "allow_tags": ["p", "br", "b", "i", "em", "strong", "h1", "h2", "h3", "blockquote"]
    }
  }
}
